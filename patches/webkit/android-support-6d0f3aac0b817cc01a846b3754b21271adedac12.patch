+        // handler to avoid crashes.
+        {
+            Options::AllowUnfinalizedAccessScope scope;
+            Options::usePollingTraps() = true;
+            Options::useWasmFaultSignalHandler() = false;
+            Options::useWasmFastMemory() = false;
+        }
+#endif
+
