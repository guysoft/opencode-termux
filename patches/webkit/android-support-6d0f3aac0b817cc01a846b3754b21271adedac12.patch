diff --git a/Source/bmalloc/bmalloc/SystemHeap.cpp b/Source/bmalloc/bmalloc/SystemHeap.cpp
--- a/Source/bmalloc/bmalloc/SystemHeap.cpp
+++ b/Source/bmalloc/bmalloc/SystemHeap.cpp
@@ -173,7 +173,13 @@ void* SystemHeap::malloc(size_t size, FailureAction action)
 
 void* SystemHeap::memalign(size_t alignment, size_t size, FailureAction action)
 {
+#if defined(__ANDROID__)
+    void* result = nullptr;
+    if (::posix_memalign(&result, alignment, size) != 0)
+        result = nullptr;
+#else
     void* result = ::aligned_alloc(alignment, size);
+#endif
     RELEASE_BASSERT(action == FailureAction::ReturnNull || result);
     return result;
 }
