diff --git a/packages/native/src/tests/buffer-methods_test.zig b/packages/native/src/tests/buffer-methods_test.zig
index 1d6d2fd..af0e7cd 100644
--- a/packages/native/src/tests/buffer-methods_test.zig
+++ b/packages/native/src/tests/buffer-methods_test.zig
@@ -1109,3 +1109,33 @@ test "colorMatrixUniform - 3 pixel buffer (simd_end = 0, all scalar)" {
         try expectRGBAApprox(ansi.rgbaFromFloats(expected_r, expected_g, expected_b, 1.0), buf.buffer.fg[i], 0.001);
     }
 }
+
+test "setCellWithAlphaBlending - out-of-range u32 coordinates are ignored, not fatal" {
+    // Regression: coordinates arrive through a u32 C ABI, so a negative value
+    // from the caller wraps to a huge u32. The old code did @intCast(u32->i32)
+    // and trapped ("integer does not fit in destination type"), aborting the
+    // process (seen when backgrounding a shell command with Ctrl+B).
+    const pool = gp.initGlobalPool(std.testing.allocator);
+    defer gp.deinitGlobalPool();
+
+    var buf = try OptimizedBuffer.init(
+        std.testing.allocator,
+        4,
+        4,
+        .{ .pool = pool, .id = "test-buffer" },
+    );
+    defer buf.deinit();
+
+    const fg = ansi.rgbaFromFloats(1.0, 1.0, 1.0, 1.0);
+    const bg = ansi.rgbaFromFloats(0.0, 0.0, 0.0, 1.0);
+
+    // negative coordinates as they reach the native layer
+    buf.setCellWithAlphaBlending(0xFFFFFFFF, 0xFFFFFFFF, 'A', fg, bg, 0);
+    buf.setCellWithAlphaBlending(0xFFFFFFFF, 5, 'B', fg, bg, 0);
+    buf.setCellWithAlphaBlending(5, 0xFFFFFFFF, 'C', fg, bg, 0);
+    buf.setCellWithAlphaBlending(999999, 999999, 'D', fg, bg, 0);
+
+    // in-range drawing still works
+    buf.setCellWithAlphaBlending(1, 1, 'E', fg, bg, 0);
+    try std.testing.expectEqual(@as(u32, 'E'), buf.buffer.char[1 * 4 + 1]);
+}
