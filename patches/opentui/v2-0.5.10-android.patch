index 0000000..1d360e3
--- /dev/null
+++ b/packages/native/src/android-translate-c-shim.h
@@ -0,0 +1,5 @@
+// Force-included before any bionic header: Zig's translate-c cannot parse
+// clang nullability annotations (_Nullable/_Nonnull on array params), so we
+// expand them to nothing. Harmless for real C compilation (clang knows them).
+#define _Nullable
+#define _Nonnull
