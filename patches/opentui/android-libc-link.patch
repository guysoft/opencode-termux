@@ -494,6 +498,57 @@ fn buildTarget(
     addNativeAudioDependencies(b, lib, target, macos_sdk_path);
     addYogaDependencies(b, lib);
 
+    // On Android, the .so must have NEEDED libc.so so dlopen can resolve
+    // symbols like getauxval. Zig doesn't bundle Android libc, so we directly
+    // add the NDK sysroot's libc.so stub as a link input.
+    const os_tag = target.result.os.tag;
+    const abi = target.result.abi;
+    if (os_tag == .linux and (abi == .android or abi == .androideabi)) {
+        const ndk_home = std.process.getEnvVarOwned(b.allocator, "ANDROID_NDK_HOME") catch null;
+        const sysroot = if (ndk_home) |home|
+            std.fmt.allocPrint(b.allocator, "{s}/toolchains/llvm/prebuilt/linux-x86_64/sysroot", .{home}) catch null
+        else
+            null;
+
+        // Allow an explicit override of the lib dir (e.g. when the NDK layout
+        // differs), otherwise default to aarch64-linux-android API 24.
+        const arch_lib = std.process.getEnvVarOwned(b.allocator, "ANDROID_NDK_LIB_DIR") catch null;
+        const crt_dir = if (arch_lib) |dir|
+            dir
+        else if (sysroot) |sr|
+            std.fmt.allocPrint(b.allocator, "{s}/usr/lib/aarch64-linux-android/24", .{sr}) catch null
+        else
+            null;
+
+        if (crt_dir) |dir| {
+            // Use addObjectFile to directly link the libc.so stub without
+            // triggering Zig's native glibc/musl libc provision.
+            const libc_path = std.fmt.allocPrint(b.allocator, "{s}/libc.so", .{dir}) catch unreachable;
+            lib.addObjectFile(.{ .cwd_relative = libc_path });
+
+            // Zig does not bundle Android libc, so point it at the NDK sysroot
+            // (headers + CRT objects) via a libc file. Without this, linking
+            // fails with "unable to provide libc for target ... android".
+            if (sysroot) |sr| {
+                const include_dir = std.fmt.allocPrint(b.allocator, "{s}/usr/include", .{sr}) catch unreachable;
+                const sys_include_dir = std.fmt.allocPrint(b.allocator, "{s}/usr/include/aarch64-linux-android", .{sr}) catch unreachable;
+                // All six fields are required by LibCInstallation.parse.
+                const libc_contents = std.fmt.allocPrint(
+                    b.allocator,
+                    \\include_dir={s}
+                    \\sys_include_dir={s}
+                    \\crt_dir={s}
+                    \\msvc_lib_dir=
+                    \\kernel32_lib_dir=
+                    \\gcc_dir=
+                    \\
+                , .{ include_dir, sys_include_dir, dir }) catch unreachable;
+                const libc_file = b.addWriteFiles().add("android-libc.txt", libc_contents);
+                lib.setLibCFile(libc_file);
+            }
+        }
+    }
+
